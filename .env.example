# Restricted Bible data sync (scripts/sync-data.mjs, runs on `prebuild`).
# Pulls licensed JSON (e.g. NBG-vertaling 1951) from the PRIVATE data repo at
# build time. Set GITHUB_TOKEN in Vercel Project Settings -> Environment Variables.

# Fine-grained PAT with read-only "Contents" access to the data repo. REQUIRED on Vercel.
GITHUB_TOKEN=

# Optional overrides (defaults shown):
# GITHUB_DATA_REPO=AlexLamper/bijbelapi-data
# GITHUB_DATA_BRANCH=main
# GITHUB_DATA_SUBDIR=data
# GITHUB_DATA_FILES=nbg51.json      # comma-separated basenames; "*" = all .json under subdir
# GITHUB_DATA_DEST=private/data/bibles


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The deployed site uses the `scriptura` database on the cluster. A URI whose
# path names a different database connects fine and silently reads and writes
# the wrong data, so check the tail of this value, not just the host.
MONGODB_URI=

NEXTAUTH_URL=
NEXTAUTH_SECRET=


# ---------------------------------------------------------------------------
# In-app purchases (RevenueCat -> MongoDB)
# ---------------------------------------------------------------------------
# Three separate things read these. Missing any one of them fails quietly in a
# way that looks like a working app right up until someone pays:
#
#   REVENUECAT_WEBHOOK_AUTHORIZATION  app/api/mobile/revenuecat-webhook
#   REVENUECAT_REST_API_KEY           lib/revenuecatSync.ts, /api/v1/sync-premium
#   REVENUECAT_PRO_ENTITLEMENT_ID     lib/revenuecatSync.ts (defaults to "pro")
#
# The contract underneath all of it: RevenueCat's app_user_id IS the Mongo
# User._id. The app guarantees that by calling Purchases.logIn(user.id) right
# after authenticating. If those ever drift, purchases succeed at Apple and
# unlock nothing on the server.

# Static value set in the RevenueCat dashboard under Webhooks -> Authorization
# header. Without it (and without the secret below) the webhook refuses to run
# at all and answers 500, rather than flipping entitlements for anyone who
# finds the URL.
REVENUECAT_WEBHOOK_AUTHORIZATION=

# Optional. Only needed when a signing proxy sits in front of the webhook and
# sends x-revenuecat-signature; plain RevenueCat does not sign bodies.
# REVENUECAT_WEBHOOK_SECRET=

# Secret REST key (v1) from RevenueCat -> API keys. This is the authoritative
# read. It is what makes "Herstel aankopen" work: RevenueCat fires no webhook
# for an already-owned purchase, a restore, or a reinstall, so without this key
# /api/v1/sync-premium answers 500 and those users stay locked out forever.
REVENUECAT_REST_API_KEY=

# Must match the entitlement identifier in RevenueCat exactly (lowercase).
# REVENUECAT_PRO_ENTITLEMENT_ID=pro

# --- SEO / site verification -------------------------------------------------

# Search Console -> Instellingen -> Eigendomsverificatie -> HTML-tag. Paste ONLY
# the token from content="..." here, not the whole <meta> tag. When unset, the
# meta tag is left out entirely rather than rendered empty.
# GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools -> Site toevoegen -> Meta tag. Same rule: token only.
# BING_SITE_VERIFICATION=
